# Copy to deploy/.env (git-ignored) to override the update.sh defaults.

# Commit identity used for the automated commits.
GIT_AUTHOR_NAME="ai-crawler-ipranges"
GIT_AUTHOR_EMAIL="ai-crawler-ipranges@localhost"

# Branch and remote to mirror.
BRANCH="main"
REMOTE="origin"

# Discard local changes and hard-reset to the remote before crawling.
# Keep 1 on a dedicated container; set 0 if you edit files there by hand.
RESET_LOCAL="1"

# Set 0 to commit locally without pushing (useful for a first test run).
PUSH="1"

# Interpreter to use, if not the system python3.
# PYTHON="/usr/bin/python3.12"
